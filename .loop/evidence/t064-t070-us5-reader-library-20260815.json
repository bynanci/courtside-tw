  "tasks": {
    "T064": "ReaderLibraryApiIT, ProgressMergePolicyTest and six browser scenarios cover API contracts, generated merge behavior, two-device synchronization, logout/session expiry, revision invalidation, withdrawal and deletion.",
    "T065": "V014 adds reader profiles, unique bookmarks, bounded revision-aware progress, erasure jobs and append-only receipt protection; V006 was already occupied.",
    "T066": "Authenticated bookmark/progress APIs are idempotent, deny stale revision positions and return withdrawn metadata without article bodies.",
    "T067": "Preview is side-effect free, apply is explicit, invalid candidates are rejected and the newer valid candidate wins deterministically.",
    "T068": "Reader controls and /library synchronize authenticated state while preserving unavailable-content and anonymous-local behavior.",
    "T069": "Export/deletion requires a fresh authenticated reader, removes identifiable library data and keeps only a non-identifying append-only receipt.",
    "T070": "The complete browser regression exercises concurrent devices, logout, session expiry, revision change and withdrawn bookmarks; reading-progress.md records the merge contract."
  },
