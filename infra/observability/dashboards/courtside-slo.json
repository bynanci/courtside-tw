{
  "annotations": { "list": [] },
  "description": "T083 provider-neutral SLO dashboard. Missing source heartbeat is a release HOLD, never a green zero.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Incident response",
      "type": "link",
      "url": "https://github.com/bynanci/courtside-tw/blob/main/docs/operations/incident-response.md"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Must equal seven. Any absent, stale or non-one heartbeat pages and keeps release HOLD.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 7 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "kind": "telemetry-coverage",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(max by (surface) (courtside_observability_source_up{environment=\"$environment\"} == 1))",
          "legendFormat": "healthy sources",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Telemetry coverage: 7/7 required",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "99.9% monthly successful public issue/article origin responses and p95 <=300 ms.",
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 2,
      "surface": "public-read",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"public-read\",objective=\"availability\",budget=\"met\"}[30d])) / clamp_min(sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"public-read\",objective=\"availability\"}[30d])), 0.000000001)",
          "legendFormat": "availability",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(courtside_slo_latency_seconds_bucket{environment=\"$environment\",surface=\"public-read\",objective=\"origin-latency\"}[5m])))",
          "legendFormat": "origin p95 seconds",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Public read",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "99% of accepted publication commands complete or explicitly block within 60 seconds.",
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 3,
      "surface": "publication-jobs",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"publication-jobs\",objective=\"completion\",budget=\"met\"}[30d])) / clamp_min(sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"publication-jobs\",objective=\"completion\"}[30d])), 0.000000001)",
          "legendFormat": "within 60s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Publication jobs",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Origin denial: 99% within 30 seconds and 100% within 60 seconds.",
      "fieldConfig": {
        "defaults": { "unit": "percentunit" },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 4,
      "surface": "withdrawal",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"withdrawal\",objective=\"origin-denial-30s\",budget=\"met\"}[30d])) / clamp_min(sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"withdrawal\",objective=\"origin-denial-30s\"}[30d])), 0.000000001)",
          "legendFormat": "within 30s",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"withdrawal\",objective=\"origin-denial-60s\",budget=\"missed\"}[1h]))",
          "legendFormat": "60s breaches",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Withdrawal",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "99% of public changes become visible in anonymous search within 60 seconds.",
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 5,
      "surface": "search-freshness",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"search-freshness\",objective=\"visible-in-search\",budget=\"met\"}[30d])) / clamp_min(sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"search-freshness\",objective=\"visible-in-search\"}[30d])), 0.000000001)",
          "legendFormat": "within 60s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Search freshness",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "99% of accepted rights-valid images reach READY within five minutes.",
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 6,
      "surface": "media-processing",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"media-processing\",objective=\"ready\",budget=\"met\"}[30d])) / clamp_min(sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"media-processing\",objective=\"ready\"}[30d])), 0.000000001)",
          "legendFormat": "within 300s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Media processing",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Safety invariant: no withdrawal purge may exceed 60 seconds. Normal publish purge has no new release SLO here.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 20 },
      "id": 7,
      "surface": "cache-purge",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(courtside_slo_observations_total{environment=\"$environment\",surface=\"cache-purge\",objective=\"withdrawal-purge\",budget=\"missed\"}[1h]))",
          "legendFormat": "60s breaches",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Withdrawal cache purge",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Safety invariant: zero new dead-lettered outbox events.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 20 },
      "id": 8,
      "surface": "dead-letters",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(increase(courtside_outbox_handler_events_total{environment=\"$environment\",outcome=\"dead_lettered\"}[1h]))",
          "legendFormat": "new dead letters",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Dead letters",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["courtside", "t083", "slo", "activation-gated"],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "includeAll": false,
        "label": "Environment",
        "multi": false,
        "name": "environment",
        "query": "label_values(courtside_observability_source_up, environment)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Courtside TW — T083 SLO gates",
  "uid": "courtside-slo-v1",
  "version": 1,
  "weekStart": "monday"
}
