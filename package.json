{
  "name": "courtside-tw",
  "version": "0.1.0",
  "private": true,
  "description": "台灣籃球雜誌電子書的 monorepo root baseline",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.14.x",
    "pnpm": "11.7.x"
  },
  "scripts": {
    "setup": "make setup",
    "dev": "make dev",
    "demo": "node apps/web/scripts/start-reader-demo.mjs",
    "format": "prettier --write \"apps/**/*.{js,mjs,cjs,ts,tsx,vue,json}\" \"packages/**/*.{js,mjs,cjs,ts,tsx,vue,json}\" \"scripts/**/*.{js,mjs,cjs}\" \"contracts/**/*.{json,yaml,yml}\" \"*.{js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"apps/**/*.{js,mjs,cjs,ts,tsx,vue,json}\" \"packages/**/*.{js,mjs,cjs,ts,tsx,vue,json}\" \"scripts/**/*.{js,mjs,cjs}\" \"contracts/**/*.{json,yaml,yml}\" \"*.{js,mjs,cjs,json}\"",
    "lint": "make lint",
    "typecheck": "make typecheck",
    "test": "make test",
    "test:demo": "node apps/web/scripts/verify-reader-demo.mjs",
    "contract": "make contract",
    "verify": "make verify",
    "contract:schema": "node scripts/validate-content-schema.mjs",
    "contract:openapi": "node scripts/validate-openapi.mjs",
    "contract:observability": "node scripts/validate-observability.mjs",
    "contract:analytics": "node scripts/validate-analytics-privacy.mjs",
    "test:traceability": "node --test scripts/test/validate-traceability.test.mjs",
    "contract:traceability": "node --test scripts/test/validate-traceability.test.mjs && node scripts/validate-traceability.mjs",
    "test:beta-release": "node --test scripts/test/validate-beta-release.test.mjs",
    "contract:beta-release": "node --test scripts/test/validate-beta-release.test.mjs && node scripts/validate-beta-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.66.0",
    "vue-eslint-parser": "10.4.1",
    "yaml": "2.9.0"
  }
}
