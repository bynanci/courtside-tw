{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courtside.tw/contracts/provenance-manifest.schema.json",
  "title": "Edition Provenance manifest v1: JCS string-only profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "publicationId",
    "revision",
    "publishedAt",
    "checksum",
    "rightsScope",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "publicationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.\\d{1,9})?Z$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rightsScope": {
      "enum": ["DIGEST_ONLY", "PERMANENT_PUBLIC"]
    },
    "assets": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "digest"],
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
