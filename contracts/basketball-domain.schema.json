          {
            "$ref": "#/$defs/Team"
          },
          {
            "$ref": "#/$defs/Player"
          },
          {
            "$ref": "#/$defs/Season"
          },
          {
            "$ref": "#/$defs/TeamSeason"
          },
          {
            "$ref": "#/$defs/PlayerTeamStint"
          },
          {
            "$ref": "#/$defs/Competition"
          },
          {
            "$ref": "#/$defs/Tournament"
          },
          {
            "$ref": "#/$defs/Game"
          },
          {
            "$ref": "#/$defs/NationalTeamCampaign"
          },
